[Unit]
Description=Adult Income Model Inference API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=YOUR_VM_USER
WorkingDirectory=/home/YOUR_VM_USER
EnvironmentFile=/home/YOUR_VM_USER/income-api.env
ExecStart=/home/YOUR_VM_USER/.venv/bin/python /home/YOUR_VM_USER/src/serve.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
