MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_NAME=Adult-Income
# Local serving; the application does not automatically load this file.
MODEL_PATH=./models/model.joblib
# AWS CLI/SDK region; EC2 uses its IAM instance profile for credentials.
AWS_DEFAULT_REGION=ap-southeast-2
# Set ARTIFACT_BUCKET only when running the S3-backed server on EC2.
# ARTIFACT_BUCKET=your-bucket-name
